# Endereço do Portal Guarese's ON (sem barra no fim)
PORTAL_URL=https://portal.exemplo.com.br
# Endereço curto da loja no portal (Gestão da loja → Site da loja)
LOJA_SLUG=shop-luana-araujo
# Chave do site gerada no portal (mostrada uma única vez). Nunca publique esta chave.
PORTAL_CHAVE=
# Endereço público deste site (para links, mapa do site e compartilhamento)
NEXT_PUBLIC_SITE_URL=https://shopluanaaraujo.com.br
# Endereço das fotos (o mesmo NEXT_PUBLIC_SUPABASE_URL do portal) — liberado na política de conteúdo
FOTOS_URL=https://xxxx.supabase.co
