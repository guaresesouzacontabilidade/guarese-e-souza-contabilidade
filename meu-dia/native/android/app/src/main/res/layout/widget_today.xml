<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/w_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Meu Dia"
            android:textColor="#EEF1FB"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/w_item1" style="@style/MeuDiaWidgetItem" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/w_item2" style="@style/MeuDiaWidgetItem" />
    <TextView android:id="@+id/w_item3" style="@style/MeuDiaWidgetItem" />

    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A9B1C7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_balance_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#A9B1C7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#5EEAD4"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_bill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FBBF24"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_add_expense"
            style="@style/MeuDiaWidgetButton"
            android:text="+ Despesa" />

        <TextView
            android:id="@+id/w_add_event"
            style="@style/MeuDiaWidgetButton"
            android:layout_marginStart="8dp"
            android:text="+ Compromisso" />
    </LinearLayout>
</LinearLayout>
