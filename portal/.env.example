# =============================================================================
# Portal Guarese's ON — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na hospedagem (Vercel).
# Variáveis com NEXT_PUBLIC_ chegam ao navegador; as demais ficam no servidor.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("publishable" ou "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta ("secret" ou "service_role") — NUNCA use prefixo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Aplicação ----------------------------------------------------------------
# Endereço público do portal (usado nos e-mails e links de convite)
NEXT_PUBLIC_SITE_URL=https://portal.seudominio.com.br
# producao | demonstracao | desenvolvimento (demonstração/desenvolvimento exibem faixa de aviso)
NEXT_PUBLIC_AMBIENTE=producao
# Segredo para as rotas de agendamento (/api/cron/*). Gere com: openssl rand -hex 32
CRON_SECRET=troque-por-um-valor-aleatorio

# --- E-mail (SMTP) — opcional ---------------------------------------------------
# Sem SMTP o portal NÃO simula envios: os e-mails ficam registrados como
# "não configurado" no histórico e os convites exibem o link para copiar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal Guarese's ON <nao-responda@seudominio.com.br>"

# --- Notificações no aparelho (Web Push) ------------------------------------------
# Par de chaves VAPID (gere com: npx web-push generate-vapid-keys). O script de
# publicação cria e mantém o par sozinho. Sem as chaves, os avisos ficam só no
# sino do portal (nada é enviado aos aparelhos). A privada é SOMENTE servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente exigido pelos serviços de notificação (padrão: o endereço do portal)
VAPID_SUBJECT=

# --- Notas automáticas (SEFAZ e NFS-e Nacional) ------------------------------------
# Chave (32 bytes em base64) que cifra os certificados A1 guardados para a busca
# automática de notas. O script de publicação cria e mantém a chave sozinho. Para
# gerar à mão: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SOMENTE servidor. Se for trocada ou perdida, os certificados precisam ser
# cadastrados de novo. Sem ela, o cadastro de certificados fica desligado.
CERTIFICADOS_CHAVE=
# 1 = demonstração ou teste: o portal NÃO consulta a SEFAZ nem o Ambiente Nacional
# (a publicação da demonstração já liga). Deixe vazio no portal oficial.
NOTAS_AUTOMATICAS_SEM_REDE=

# --- WhatsApp Business Platform (API oficial da Meta) — opcional ----------------
# Fica desconectado até que o token seja informado aqui E o número (Phone Number ID)
# e o modelo de mensagem aprovado sejam configurados em Configurações → Integrações.
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Antivírus ClamAV (clamd) — opcional ----------------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- OCR (leitura de imagens e PDFs digitalizados) -----------------------------
# Processado no próprio servidor com Tesseract (nenhum documento é enviado a terceiros).
# Apenas o modelo de idioma português é baixado na primeira execução.
OCR_ATIVO=true
# Caminho local ou URL para os modelos de idioma (opcional)
OCR_CAMINHO_IDIOMAS=

# --- Processador contínuo da fila (opcional: npm run worker) --------------------
# Não é necessário na Vercel (o banco agenda as chamadas). Útil em servidor próprio.
PORTAL_URL=
WORKER_INTERVALO_SEGUNDOS=30
WORKER_ROTINA_DIARIA=0
